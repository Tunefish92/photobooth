# Force LF regardless of the committer's platform/core.autocrlf setting --
# CRLF line endings in install.sh would break its "#!/usr/bin/env bash"
# shebang on Linux (the Pi it's meant to run on).
*.sh text eol=lf
scripts/photobooth.desktop text eol=lf
*.py text eol=lf
*.qml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
